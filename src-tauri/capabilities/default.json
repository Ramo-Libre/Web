{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "enables the default permissions",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "store:default",
    {
      "identifier": "fs:allow-read-dir",
      "allow": [
        { "path": "$APPDATA" },
        { "path": "$APPDATA/*" },
        { "path": "$APPDATA/**" }
      ]
    },
    {
      "identifier": "fs:allow-size",
      "allow": [
        { "path": "$APPDATA" },
        { "path": "$APPDATA/*" }
      ]
    }
  ]
}
