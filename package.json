{
	"name": "@ramolibre/web",
	"private": true,
	"version": "x.x.x",
	"type": "module",
	"packageManager": "bun@1.3.14",
	"engines": {
		"node": ">=22.0.0"
	},
	"scripts": {
		"dev": "vite dev",
		"build:icons": "cp node_modules/@ramo-libre/ui-themes/src/assets/web.svg static/ && pwa-assets-generator",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"format": "prettier --write .",
		"lint": "prettier --check . && eslint ."
	},
	"devDependencies": {
		"@eslint/compat": "2.1.0",
		"@eslint/js": "10.0.1",
		"@faker-js/faker": "^10.5.0",
		"@iconify/svelte": "^5.2.2",
		"@lucide/svelte": "1.18.0",
		"@ramo-libre/dsl-parser": "^1.0.0",
		"@ramo-libre/solver": "^0.1.1",
		"@ramo-libre/ui-themes": "^1.1.0",
		"@sveltejs/adapter-static": "^3.0.10",
		"@sveltejs/kit": "2.65.1",
		"@sveltejs/vite-plugin-svelte": "7.1.2",
		"@tailwindcss/vite": "4.3.1",
		"@tauri-apps/cli": "^2.11.4",
		"@types/katex": "^0.16.8",
