		"globals": "17.6.0",
		"katex": "^0.17.0",
		"prettier": "3.8.4",
		"prettier-plugin-svelte": "4.1.1",
		"prettier-plugin-tailwindcss": "0.8.0",
		"rollup-plugin-visualizer": "^7.0.1",
		"svelte": "5.56.3",
		"svelte-check": "4.6.0",
		"tailwindcss": "4.3.1",
		"tw-animate-css": "1.4.0",
		"typescript": "6.0.3",
		"typescript-eslint": "8.61.1",
